cmake_minimum_required(VERSION 3.15)

set(CMAKE_CXX_STANDARD 23)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

project(Olympus VERSION 1.0 LANGUAGES CXX)

include(cmake/CPM.cmake)

if(APPLE)
    set(VULKAN_SDK_PATH "$ENV{VULKAN_SDK}")
    if(NOT VULKAN_SDK_PATH)
        set(VULKAN_SDK_PATH "/Users/aymanhachkal/VulkanSDK/1.4.341.1/macOS")
    endif()
    list(APPEND CMAKE_PREFIX_PATH "${VULKAN_SDK_PATH}")
endif()

find_package(Vulkan REQUIRED)
CPMAddPackage("gh:glfw/glfw#3.4")
CPMAddPackage("gh:g-truc/glm#1.0.1")

add_executable(${PROJECT_NAME} src/main.cpp)
target_include_directories(${PROJECT_NAME} PRIVATE ${Vulkan_INCLUDE_DIRS})
target_link_libraries(${PROJECT_NAME} Vulkan::Vulkan glfw glm)
